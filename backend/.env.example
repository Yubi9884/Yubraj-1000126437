# Copy to .env, or run npm run setup. Never commit the real .env.
PORT=4000
HOST=127.0.0.1
# List the browser origins allowed to send cross-origin requests to the API.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Copy your Atlas address from Connect > Drivers. This value is required.
MONGODB_URI=
# Enter the Atlas database user's details here. Keep the password inside double quotes.
# These can be left blank if the connection string already contains the login details.
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=studypass
# Local MongoDB data directory for npm run start:local. Tests use a separate directory.
LOCAL_DATA_DIR=.data/mongodb
# Optional: set the download directory for the local MongoDB binary.
MONGOMS_DOWNLOAD_DIR=
# The setup script generates the private signing key used for login tokens.
JWT_SECRET=
# Optional Google sign-in. Local email/password sign-in works without this.
GOOGLE_CLIENT_ID=
# Generated by npm run setup. Only the public key is returned to the browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:developer@example.com
# Check for due device reminders every 60,000 milliseconds by default.
REMINDER_INTERVAL_MS=60000
# Anonymous sample workspaces are enabled for local development only.
ENABLE_DEMO=true
