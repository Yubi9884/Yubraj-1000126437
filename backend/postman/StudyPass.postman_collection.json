{
  "info": {
    "name": "StudyPass NZ API",
    "description": "Local full-stack API tests. Register or log in first. Private values are saved only in your selected Postman environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1 Health and authentication",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.response.to.have.status(200));",
                  "pm.test('MongoDB is connected', () => pm.expect(pm.response.json().database).to.eql('connected'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Student\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sampleEmail = pm.variables.replaceIn('student.{{$guid}}@example.test');",
                  "pm.variables.set('email', sampleEmail);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.response.to.have.status(201));",
                  "pm.test('Session token is returned and saved', () => {",
                  "  const session = pm.response.json();",
                  "  pm.expect(session.token).to.be.a('string').and.not.be.empty;",
                  "  pm.expect(session.user.email).to.be.a('string').and.not.be.empty;",
                  "  pm.environment.set('token', session.token);",
                  "  pm.environment.set('email', session.user.email);",
                  "});",
                  "pm.test('No password hash is exposed', () => pm.expect(pm.response.json().user).not.to.have.property('passwordHash'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.response.to.have.status(200));",
                  "pm.test('Session token is returned and saved', () => {",
                  "  const session = pm.response.json();",
                  "  pm.expect(session.token).to.be.a('string').and.not.be.empty;",
                  "  pm.expect(session.user.email).to.be.a('string').and.not.be.empty;",
                  "  pm.environment.set('token', session.token);",
                  "  pm.environment.set('email', session.user.email);",
                  "});",
                  "pm.test('No password hash is exposed', () => pm.expect(pm.response.json().user).not.to.have.property('passwordHash'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Current account",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 Checklist CRUD",
      "item": [
        {
          "name": "Create checklist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/checklists",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "checklists"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman project hand-in\",\n  \"description\": \"Created by the API collection.\",\n  \"items\": [\n    {\n      \"label\": \"Run the tests\"\n    },\n    {\n      \"label\": \"Review the report\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.response.to.have.status(201));",
                  "pm.test('Checklist has two items and a MongoDB ID', () => {",
                  "  const checklist = pm.response.json().checklist;",
                  "  pm.expect(checklist.items).to.have.lengthOf(2);",
                  "  pm.expect(checklist._id).to.match(/^[a-f0-9]{24}$/);",
                  "  pm.environment.set('checklistId', checklist._id);",
                  "  pm.environment.set('itemId', checklist.items[0].id);",
                  "});"
                ]
              }
