          ]
        },
        {
          "name": "Read checklist",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/checklists/{{checklistId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "checklists",
                "{{checklistId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rename and tick an item",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/checklists/{{checklistId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "checklists",
                "{{checklistId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated project hand-in\",\n  \"items\": [\n    {\n      \"id\": \"{{itemId}}\",\n      \"label\": \"Run all tests\",\n      \"done\": true\n    },\n    {\n      \"label\": \"Review the final report\",\n      \"done\": false\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.response.to.have.status(200));",
                  "pm.test('First item is complete', () => pm.expect(pm.response.json().checklist.items[0].done).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the updated checklist",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/checklists/{{checklistId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "checklists",
                "{{checklistId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP status', () => pm.response.to.have.status(200));",
                  "pm.test('Checklist changes were saved', () => {",
                  "  const checklist = pm.response.json().checklist;",
                  "  pm.expect(checklist.name).to.eql('Updated project hand-in');",
                  "  pm.expect(checklist.items[0].done).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
